# Isi di Vercel (Settings > Environment Variables) dan di .env lokal. JANGAN commit .env
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kandidat pair untuk snapshot (pisah koma, huruf kecil). Universe final ditentukan saat freeze.
PAIRS=btcidr,ethidr,solidr,xrpidr,dogeidr,bnbidr,adaidr,trxidr
# Kill switch manual: set ke 1 untuk menghentikan pembukaan posisi tanpa deploy ulang
KILL_SWITCH=0
